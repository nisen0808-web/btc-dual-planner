# Server-only Binance product list key. Never put the real value in source or client code.
BINANCE_API_KEY=
# Private collector write token. It never belongs in browser code.
BINANCE_COLLECTOR_TOKEN=
# Native Sites runtime only; never supply these to browser bundles.
BINANCE_ACCOUNT_VERIFY_URL=
BINANCE_ACCOUNT_BRIDGE_PRIVATE_KEY=
BINANCE_ACCOUNT_STORAGE_KEY=
BINANCE_ACCOUNT_BINDING_ENABLED=false
